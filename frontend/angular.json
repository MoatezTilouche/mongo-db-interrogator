{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "interrogator": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "polyfills": ["zone.js"],
            "styles": ["src/styles.css"],
            "outputPath": { "base": "dist", "browser": "" },
            "deployUrl": "/static/"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [{ "type": "initial", "maximumWarning": "600kB", "maximumError": "1MB" }]
            },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false, "deployUrl": "/" }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "interrogator:build:development" }
        }
      }
    }
  }
}
