# =========================
# MongoDB
# =========================
# Required: host MongoDB with Docker Desktop. For remote/Atlas, replace the URI.
# A container's localhost refers to the container, not the Docker host.
MONGODB_URI=mongodb://host.docker.internal:27017
MONGODB_DATABASE=my_database

MONGO_SCHEMA_SAMPLE_SIZE=20
MONGO_MAX_COLLECTIONS=200
MONGO_QUERY_TIMEOUT_MS=15000
SCHEMA_CACHE_ENABLED=true
SCHEMA_CACHE_TTL_SECONDS=300
SCHEMA_CACHE_COLLECTION=_system_schema_cache
SCHEMA_REBUILD_ON_STARTUP=false

# Optional operator-run database profiling (never scanned automatically).
SCAN_SAMPLE_SIZE=2000
SCAN_RECENT_SAMPLE_SIZE=500
SCAN_MAX_TIME_MS=20000
SCAN_TOTAL_BUDGET_SECONDS=600
SCAN_PAUSE_MS=200
SCAN_MAX_DEPTH=6
SCAN_MAX_PATHS=500
SCAN_CATEGORICAL_MAX_DISTINCT=30
SCAN_MAX_VALUE_LENGTH=64
SCAN_REL_SAMPLE_VALUES=200
SCAN_REL_MIN_OVERLAP=0.8
SCAN_REL_MAX_CHECKS=200
SCAN_EXCLUDE_COLLECTIONS=
SCAN_EXCLUDE_FIELDS=
SCAN_STORE_VALUES=true
# Bounded scalar examples, separate from categorical values; 0 disables them.
SCAN_SAMPLE_VALUES_PER_FIELD=5

DEFAULT_LIMIT=100
MAX_LIMIT=500


# =========================
# General LLM configuration
# =========================
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1


# =========================
# OpenAI
# =========================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Optional local OpenAI-compatible server (example: Ollama).
# Uncomment and choose installed models. No public API key is needed.
# LLM_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL is also accepted; LLM_BASE_URL takes precedence.
# LLM_API_KEY=unused
# LLM_MODEL=qwen3:8b
# Optional lighter model for template parameter extraction on this chat endpoint.
# Takes precedence over LLM_MODEL for this call only; blank inherits query model.
# TEMPLATE_PARAMETER_MODEL=qwen3.5:2b
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=unused
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_SEND_DIMENSIONS=false
# EMBEDDING_BATCH_SIZE=32
# Optional two-model routing, using the local endpoint above:
# EMBEDDING_MODEL=qwen3-embedding:4b
# EMBEDDING_DIMENSIONS=2560
# EMBEDDING_QUERY_INSTRUCTION=Given a database question, retrieve relevant database schemas, business rules, profile field descriptions and reusable query examples.
# TEMPLATE_EMBEDDING_MODEL=bge-m3
# TEMPLATE_EMBEDDING_DIMENSIONS=1024
# Query instructions apply only to schema/knowledge queries. Template inputs
# and all stored document inputs stay plain. See docs/embedding-routing.md.
# LLM_EXTRA_BODY={"think":false}
# LLM_DROP_PARAMS=service_tier,reasoning_effort
# LLM_STRUCTURED_OUTPUT=true
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=2
# Unset structured output preserves the existing per-role formats.
# Verify server-specific options; supported thinking options differ between servers.
SCHEMA_ENRICHMENT_MODEL=gpt-6.1-sol
SCHEMA_ENRICHMENT_BATCH_SIZE=10
SCHEMA_EMBEDDING_MODEL=text-embedding-3-small
# Optional shared query/rule dimensions; blank preserves the provider default.
SCHEMA_EMBEDDING_DIMENSIONS=
SCHEMA_RETRIEVAL_TOP_K=5
SCHEMA_RETRIEVAL_MAX_FIELDS=60
SCHEMA_RELATIONSHIP_EXPANSION=true
# Budget for schema, knowledge and preferences (instructions/question are additional).
QUERY_CONTEXT_TOKEN_BUDGET=1800
QUERY_CONTEXT_MAX_RELATIONSHIPS=8
# Optional fields per candidate; explicitly requested/rule/join fields are retained.
QUERY_CONTEXT_MAX_FIELDS_PER_COLLECTION=16



# =========================
# API
# =========================
API_KEY=
ALLOWED_ORIGINS=*


# Lightweight semantic routing

# Query history, explicit feedback, and scoped preference memory
QUERY_HISTORY_COLLECTION=query_history
QUERY_HISTORY_PREVIEW_SIZE=5
QUERY_HISTORY_PREVIEW_MAX_BYTES=8192
FEEDBACK_COLLECTION=feedback
USER_PREFERENCES_COLLECTION=user_preferences
DEFAULT_USER_ID=default
FEEDBACK_REGENERATION_TTL_SECONDS=600
USER_PREFERENCE_RETRIEVAL_LIMIT=50
DATABASE_KNOWLEDGE_COLLECTION=_system_database_knowledge
KNOWLEDGE_RETRIEVAL_TOP_K=5
KNOWLEDGE_MIN_SEMANTIC_SIMILARITY=0.50
KNOWLEDGE_FEEDBACK_PRIORITY_BONUS=0.15
KNOWLEDGE_SCOPE_MATCH_BONUS=0.02
KNOWLEDGE_COLLECTION_MATCH_BONUS=0.05
KNOWLEDGE_FIELD_MATCH_BONUS=0.05
# Stage-specific retrieval; legacy ranking options above remain backward compatible.
KNOWLEDGE_CONTEXT_MIN_SIMILARITY=0.75
KNOWLEDGE_CONTEXT_TOP_K=3
KNOWLEDGE_VALUE_RESOLUTION_ENABLED=true
KNOWLEDGE_CATEGORICAL_MAX_DISTINCT=30
KNOWLEDGE_CATEGORICAL_SAMPLE_SIZE=50000
KNOWLEDGE_VALUE_CATALOG_TTL_SECONDS=3600
KNOWLEDGE_CASE_VARIANTS_POLICY=merge
KNOWLEDGE_CASE_SENSITIVE_FIELDS=
KNOWLEDGE_VALUE_SUGGESTION_CUTOFF=0.8
# Safe categorical profiles only; fallback after exact/case/accent matching.
VALUE_SEPARATOR_MATCHING_ENABLED=true
KNOWLEDGE_CONTEXT_FLOOR=0.30
KNOWLEDGE_RANK_SELECTION_ENABLED=true
KNOWLEDGE_KEYWORD_MATCHING_ENABLED=true
KNOWLEDGE_KEYWORD_CACHE_TTL_SECONDS=3600
KNOWLEDGE_KEYWORD_MAX_RULE_FRACTION=0.30
KNOWLEDGE_KEYWORD_MAX_EXTRA=2
KNOWLEDGE_RULE_SUGGESTED_COLLECTIONS_ENABLED=true
KNOWLEDGE_RULE_SUGGESTED_COLLECTIONS_MAX=2
KNOWLEDGE_GENERATOR_TOP_K=8
KNOWLEDGE_STATUS_TERMS=failed,failure,success,succeeded,successful,status,state,code,pending,cancelled,completed,in progress,échoué,échouée,échec,réussi,réussie,succès,statut,état
# Optional regex overrides: KNOWLEDGE_TIME_EXPRESSION_PATTERN, KNOWLEDGE_DATE_FIELD_PATTERN.
KNOWLEDGE_AUTO_PROMOTION_ENABLED=false
# immediate activates eligible rules on the first feedback; confirmations waits for evidence.
KNOWLEDGE_LEARNING_MODE=confirmations
KNOWLEDGE_AUTO_PROMOTION_MIN_CONFIRMATIONS=3
KNOWLEDGE_AUTO_PROMOTION_MIN_CONFIDENCE=0.90
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small

# Query cost guard and structured performance learning
QUERY_COST_GUARD_ENABLED=true
QUERY_HEAVY_RESULT_THRESHOLD=5000
QUERY_HEAVY_EXECUTION_MS_THRESHOLD=1500
QUERY_HEAVY_RISK_THRESHOLD=0.70
QUERY_PERFORMANCE_COLLECTION=_system_query_performance
QUERY_PERFORMANCE_SIMILARITY_THRESHOLD=0.75
QUERY_DEFAULT_OPTIMIZED_LIMIT=100
QUERY_MAX_RETURN_ROWS=50000

QUERY_MAX_OPTIMIZATION_ITERATIONS=3

# Optional observability; secrets stay in your runtime .env, not the image.
LANGSMITH_TRACING=false
# Also required to trace Ollama or any custom chat/embedding endpoint.
# Traces export instrumented inputs/outputs to the LangSmith endpoint.
LANGSMITH_ALLOW_LOCAL=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mongo-db-interrogator
TOKEN_USAGE_LOG_ENABLED=false
TOKEN_USAGE_LOG_PATH=data/token_usage.jsonl
PROMPT_VARIANT=default

# Deprecated artifact generation is disabled in the active workflow.
ENABLE_PYTHON_ARTIFACTS=false
PYTHON_ARTIFACT_DIR=/app/data/artifacts

QUERY_TEMPLATES_COLLECTION=_system_query_templates
SEMANTIC_TEMPLATE_CACHE_ENABLED=true
SEMANTIC_TEMPLATE_TOP_K=3
SEMANTIC_TEMPLATE_MIN_THRESHOLD=0.65
SEMANTIC_TEMPLATE_SUGGEST_THRESHOLD=0.82
# Mixed concise lookup syntax is disabled unless deployment support is verified.
MONGO_SUPPORTS_LOOKUP_PIPELINE_WITH_LOCAL_FOREIGN=false
QUERY_LEARNED_OPTIMIZATION_ENABLED=true
QUERY_LEARNED_OPTIMIZATION_MIN_SUCCESSES=2
# Stored-profile runtime controls (in-memory facts only; no request-time DB reads).
# All features preserve legacy behavior when no profile is published.
DATE_NORMALIZATION_ENABLED=true
DATE_ENFORCE_QUESTION_RANGE=true
DATE_PLAUSIBILITY_MODE=error
DATE_PLAUSIBILITY_MARGIN_DAYS=365
DATE_DAY_FIRST=true
# Empty uses server-local calendar boundaries; IANA zone, e.g. Europe/Paris.
DATE_TIMEZONE=
# Empty uses config/date_expressions.json. Relative week semantics live there.
DATE_EXPRESSIONS_FILE=
GENERATOR_PROFILE_FACTS_ENABLED=true
GENERATOR_FACTS_MAX_VALUES_PER_FIELD=15
GENERATOR_FACTS_MAX_CHARS=2400
# Rank capped categorical values and matching fields by question relevance.
GENERATOR_FACTS_RELEVANCE_FIRST=true
PROFILE_VALIDATION_MODE=strict
RELATIONSHIP_ENFORCEMENT=warn

# Generator prompt data selection; execution/validation retain full schemas.
SCHEMA_PRUNE_ENABLED=true
SCHEMA_PRUNE_MAX_FIELDS=40
SCHEMA_PRUNE_INCLUDE_PARENTS=false
SCHEMA_PRUNE_MIN_SIGNALS=3
PRUNE_ALLOW_PII_IF_NAMED=true
RULE_GATING_MODE=on
RULE_GENERIC_TOKEN_FRACTION=0.30
RULE_MIN_TOKEN_OVERLAP=1
RULE_GATE_MIN_SIMILARITY=0.30
GENERATOR_MAX_RULES=4
GENERATOR_FACTS_MAX_FIELDS=6
# Comma-separated values, or a JSON array; compared after normalization.
FACTS_IGNORE_VALUES=
GENERATOR_COLLECTION_GATE=log
# Up to three approved examples from this request's existing template search.
# No additional database/embedding calls; revalidated against visible schema.
GENERATOR_APPROVED_EXAMPLES_ENABLED=true
GENERATOR_APPROVED_EXAMPLES_MAX=3
GENERATOR_APPROVED_EXAMPLES_MAX_CHARS=2400
GENERATOR_APPROVED_EXAMPLES_MIN_SIMILARITY=0.70
# Optional JSON overrides for the shared relevance weights.
QUESTION_RELEVANCE_WEIGHTS={"field_leaf":12,"field_token":3,"value":20,"rule":8,"time":15,"preference":14,"relationship":5,"default_identifier":3,"default_date":2,"default_scalar":1,"default_fallback":0}
# Junk type aliases are editable in config/type_names.json.

# Optional small intent plan; off preserves the existing generator path.
PLAN_MODE=off
PLAN_FIELD_MATCH_CUTOFF=0.85
# 0 disables plan retries; values above 1 are capped at one retry.
PLAN_MAX_RETRIES=1
# Relative to the project root; vocabulary is editable English/French JSON.
PLAN_VOCAB_FILE=config/plan_vocab.json
