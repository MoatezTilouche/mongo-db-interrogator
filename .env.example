# =========================
# MongoDB
# =========================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ecommerce_interrogator

MONGO_SCHEMA_SAMPLE_SIZE=20
MONGO_MAX_COLLECTIONS=50
MONGO_QUERY_TIMEOUT_MS=15000

DEFAULT_LIMIT=100
MAX_LIMIT=500


# =========================
# OpenRouter
# =========================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

SCHEMA_SELECTION_MODEL=qwen/qwen3.8-27b:free
QUERY_GENERATOR_MODEL=qwen/qwen3.8-27b:free
PYTHON_ARTIFACT_MODEL=qwen/qwen3.8-27b:free


# =========================
# Groq
# =========================
GROQ_API_KEY=your_key
GROQ_BASE_URL=https://api.groq.com/openai/v1

PLANNER_MODEL=openai/gpt-oss-120b
REPAIR_MODEL=openai/gpt-oss-120b


# =========================
# Gemini
# =========================
GEMINI_API_KEY=

SUMMARY_MODEL=gemini-3.5-flash


# =========================
# LLM
# =========================
LLM_MAX_OUTPUT_TOKENS=2000


# =========================
# API
# =========================
API_KEY=
ALLOWED_ORIGINS=*


# =========================
# Python artifacts
# =========================
ENABLE_PYTHON_ARTIFACTS=false
PYTHON_ARTIFACT_DIR=artifacts