# =========================
# MongoDB
# =========================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ecommerce_interrogator

MONGO_SCHEMA_SAMPLE_SIZE=20
MONGO_MAX_COLLECTIONS=50
MONGO_QUERY_TIMEOUT_MS=15000

DEFAULT_LIMIT=100
MAX_LIMIT=500


# =========================
# General LLM configuration
# =========================
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1


# =========================
# OpenRouter
# =========================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# =========================
# Agent routing
# =========================
SCHEMA_SELECTION_MODEL=qwen/qwen3.8-27b:free
SCHEMA_SELECTION_FALLBACK_MODEL=openrouter/free

PLANNER_MODEL=qwen/qwen3.8-27b:free
PLANNER_FALLBACK_MODEL=openrouter/free

QUERY_GENERATOR_MODEL=qwen/qwen3.8-27b:free
QUERY_GENERATOR_FALLBACK_MODEL=openrouter/free

REPAIR_MODEL=openrouter/free
REPAIR_FALLBACK_MODEL=qwen/qwen3.8-27b:free

SUMMARY_MODEL=openrouter/free
SUMMARY_FALLBACK_MODEL=qwen/qwen3.8-27b:free

PYTHON_ARTIFACT_MODEL=qwen/qwen3.8-27b:free
PYTHON_ARTIFACT_FALLBACK_MODEL=openrouter/free


# =========================
# API
# =========================
API_KEY=
ALLOWED_ORIGINS=*


# =========================
# Python artifacts
# =========================
ENABLE_PYTHON_ARTIFACTS=false
PYTHON_ARTIFACT_DIR=artifacts
# Lightweight semantic routing
QUERY_ROUTER_MODEL=openrouter/free
QUERY_ROUTER_FALLBACK_MODEL=qwen/qwen3.8-27b:free
