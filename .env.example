# =========================
# MongoDB
# =========================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ecommerce_interrogator

MONGO_SCHEMA_SAMPLE_SIZE=20
MONGO_MAX_COLLECTIONS=50
MONGO_QUERY_TIMEOUT_MS=15000
SCHEMA_CACHE_ENABLED=true
SCHEMA_CACHE_TTL_SECONDS=300

DEFAULT_LIMIT=100
MAX_LIMIT=500


# =========================
# General LLM configuration
# =========================
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1


# =========================
# OpenRouter
# =========================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1










# =========================
# API
# =========================
API_KEY=
ALLOWED_ORIGINS=*


# Lightweight semantic routing

# Query history and explicit feedback (no automatic preference application)
QUERY_HISTORY_COLLECTION=query_history
QUERY_HISTORY_PREVIEW_SIZE=5
QUERY_HISTORY_PREVIEW_MAX_BYTES=8192
FEEDBACK_COLLECTION=feedback

# All agents use this single OpenRouter model; no application fallback.
OPENROUTER_MODEL=openrouter/free
