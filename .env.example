# =========================
# MongoDB connection and schema sampling
# =========================
MONGODB_URI=ur_
MONGODB_DATABASE=v2DB
MONGO_SCHEMA_SAMPLE_SIZE=20
MONGO_MAX_COLLECTIONS=200
MONGO_QUERY_TIMEOUT_MS=15000
MONGO_SUPPORTS_LOOKUP_PIPELINE_WITH_LOCAL_FOREIGN=false


# =========================
# Local Ollama endpoint and default chat model
# =========================
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=unused
LLM_STRUCTURED_OUTPUT=true

# Default when an agent-specific model is blank.
LLM_MODEL=qwen3.5:4b
OPENAI_MODEL=qwen3.5:4b

LLM_TIMEOUT_SECONDS=500
LLM_MAX_RETRIES=0
LLM_EXTRA_BODY={"reasoning_effort":"none"}


# =========================
# Independent chat model for each active agent
# =========================
# Nonblank values override the default for that agent.
# All models use LLM_BASE_URL above.
QUERY_CONTEXT_MODEL=qwen3.5:4b
QUERY_GENERATOR_MODEL=qwen3:30b-a3b
QUERY_REPAIR_MODEL=qwen3:30b-a3b
TEMPLATE_PARAMETER_MODEL=llama3.2:3b
FEEDBACK_ANALYSIS_MODEL=qwen3.5:4b
SUMMARY_MODEL=llama3.2:3b
SCHEMA_ENRICHMENT_MODEL=qwen3:30b-a3b


# =========================
# Qwen embeddings: schema and knowledge retrieval
# =========================
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=unused
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSIONS=2560

# Validate dimensions without requesting resized vectors.
EMBEDDING_SEND_DIMENSIONS=false

# Applied only to retrieval queries; stored documents stay plain.
EMBEDDING_QUERY_INSTRUCTION=Given a database question, retrieve relevant database schemas, business rules, profile field descriptions and reusable query examples.


# =========================
# BGE embeddings: semantic template matching
# =========================
TEMPLATE_EMBEDDING_MODEL=bge-m3
TEMPLATE_EMBEDDING_DIMENSIONS=1024


# =========================
# Schema cache and enrichment
# =========================
SCHEMA_CACHE_ENABLED=true
SCHEMA_CACHE_TTL_SECONDS=300
SCHEMA_CACHE_COLLECTION=_system_schema_cache
SCHEMA_REBUILD_ON_STARTUP=false
SCHEMA_ENRICHMENT_BATCH_SIZE=1


# =========================
# Schema retrieval
# =========================
SCHEMA_RETRIEVAL_TOP_K=5
SCHEMA_RETRIEVAL_MAX_FIELDS=60
SCHEMA_RELATIONSHIP_EXPANSION=true


# =========================
# Backend API access
# =========================
# Empty disables API-key protection.
API_KEY=
ALLOWED_ORIGINS=*


# =========================
# Query limits and cost guard
# =========================
DEFAULT_LIMIT=100
MAX_LIMIT=500
QUERY_MAX_RETURN_ROWS=1000

QUERY_COST_GUARD_ENABLED=true
QUERY_HEAVY_RESULT_THRESHOLD=500
QUERY_HEAVY_EXECUTION_MS_THRESHOLD=300
QUERY_HEAVY_RISK_THRESHOLD=0.70
QUERY_DEFAULT_OPTIMIZED_LIMIT=100
QUERY_MAX_OPTIMIZATION_ITERATIONS=3


# =========================
# Query history and feedback
# =========================
QUERY_HISTORY_COLLECTION=query_history
QUERY_HISTORY_PREVIEW_SIZE=5
QUERY_HISTORY_PREVIEW_MAX_BYTES=8192

FEEDBACK_COLLECTION=feedback
FEEDBACK_REGENERATION_TTL_SECONDS=600


# =========================
# User preferences
# =========================
USER_PREFERENCES_COLLECTION=user_preferences
DEFAULT_USER_ID=default
USER_PREFERENCE_RETRIEVAL_LIMIT=50


# =========================
# Database knowledge retrieval
# =========================
DATABASE_KNOWLEDGE_COLLECTION=_system_database_knowledge
KNOWLEDGE_RETRIEVAL_TOP_K=10
KNOWLEDGE_MIN_SEMANTIC_SIMILARITY=0.40

KNOWLEDGE_FEEDBACK_PRIORITY_BONUS=0.15
KNOWLEDGE_SCOPE_MATCH_BONUS=0.02
KNOWLEDGE_COLLECTION_MATCH_BONUS=0.05
KNOWLEDGE_FIELD_MATCH_BONUS=0.05


# =========================
# Context-agent rule retrieval
# =========================
KNOWLEDGE_CONTEXT_MIN_SIMILARITY=0.5
KNOWLEDGE_CONTEXT_TOP_K=5
KNOWLEDGE_CONTEXT_FLOOR=0.30
KNOWLEDGE_RANK_SELECTION_ENABLED=true

KNOWLEDGE_KEYWORD_MATCHING_ENABLED=true
KNOWLEDGE_KEYWORD_CACHE_TTL_SECONDS=3600
KNOWLEDGE_KEYWORD_MAX_RULE_FRACTION=0.30
KNOWLEDGE_KEYWORD_MAX_EXTRA=2

KNOWLEDGE_RULE_SUGGESTED_COLLECTIONS_ENABLED=false
KNOWLEDGE_RULE_SUGGESTED_COLLECTIONS_MAX=2


# =========================
# Prompt relevance and context routing
# =========================
KNOWLEDGE_CONTEXT_RELEVANCE_MODE=on
GENERATOR_COLLECTION_GATE=on
QUERY_CONTEXT_FAST_PATH_MODE=on


# =========================
# Knowledge learning and promotion
# =========================
KNOWLEDGE_LEARNING_MODE=immediate
KNOWLEDGE_AUTO_PROMOTION_ENABLED=true
KNOWLEDGE_AUTO_PROMOTION_MIN_CONFIRMATIONS=1
KNOWLEDGE_AUTO_PROMOTION_MIN_CONFIDENCE=0.90


# =========================
# Semantic query template suggestions
# =========================
QUERY_TEMPLATES_COLLECTION=_system_query_templates
SEMANTIC_TEMPLATE_CACHE_ENABLED=true
SEMANTIC_TEMPLATE_TOP_K=5
SEMANTIC_TEMPLATE_MIN_THRESHOLD=0.5
SEMANTIC_TEMPLATE_SUGGEST_THRESHOLD=0.75


# =========================
# Date interpretation and validation
# =========================
DATE_NORMALIZATION_ENABLED=true
DATE_ENFORCE_QUESTION_RANGE=true
DATE_PLAUSIBILITY_MODE=error
DATE_PLAUSIBILITY_MARGIN_DAYS=365
DATE_DAY_FIRST=true

# Empty uses the server's local timezone.
DATE_TIMEZONE=

# Empty uses config/date_expressions.json.
DATE_EXPRESSIONS_FILE=


# =========================
# Stored profiles and generator facts
# =========================
GENERATOR_PROFILE_FACTS_ENABLED=true
GENERATOR_FACTS_MAX_VALUES_PER_FIELD=15
GENERATOR_FACTS_MAX_CHARS=2400
GENERATOR_FACTS_RELEVANCE_FIRST=true

PROFILE_VALIDATION_MODE=strict
RELATIONSHIP_ENFORCEMENT=warn
VALUE_SEPARATOR_MATCHING_ENABLED=true


# =========================
# Optional Python artifacts
# =========================
ENABLE_PYTHON_ARTIFACTS=false
PYTHON_ARTIFACT_DIR=artifacts


# =========================
# Query plan generation
# =========================
PLAN_MODE=on
PLAN_FIELD_MATCH_CUTOFF=0.85
PLAN_MAX_RETRIES=1
PLAN_VOCAB_FILE=config/plan_vocab.json


# =========================
# LangSmith tracing
# =========================
# Both flags enable tracing for local model endpoints.
LANGSMITH_TRACING=true
LANGSMITH_ALLOW_LOCAL=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Restore your existing LangSmith key if using tracing.
LANGSMITH_API_KEY=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
LANGSMITH_PROJECT=mongodb-interrogator
